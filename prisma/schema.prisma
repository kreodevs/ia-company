generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Super Admin ────────────────────────────────────────────────────────────

model SuperAdmin {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── Multi-tenant ───────────────────────────────────────────────────────────

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agents    Agent[]
  skills    Skill[]
  workflows Workflow[]
  runs      ExecutionRun[]
  users     TenantUser[]
  consensus TenantConsensus?
  llmConfig TenantLlmConfig?
  schedules AutonomousSchedule[]
  auditLogs AuditLog[]
  notificationConfig TenantNotificationConfig?
  usageLimits TenantUsageLimits?
  cycleState TenantCycleState?
  products TenantProduct[]
  pipelineIdeas PipelineIdea[]
  interests TenantInterest[]
}

enum TenantUserRole {
  owner
  admin
  member
}

model TenantUser {
  id           String         @id @default(cuid())
  tenantId     String
  email        String
  name         String
  passwordHash String
  role         TenantUserRole @default(member)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  passwordResetTokens PasswordResetToken[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

// ─── Agents & Skills ────────────────────────────────────────────────────────

enum AgentProvider {
  tokenlab
  openrouter
  custom
}

model Agent {
  id               String        @id @default(cuid())
  tenantId         String?
  platformSourceId String?
  name             String
  role             String
  systemPrompt     String        @db.Text
  provider         AgentProvider @default(tokenlab)
  model            String        @default("claude-3-5-sonnet-20241022")
  temperature      Float         @default(0.7)
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  tenant        Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  skills        AgentSkill[]
  workflowSteps WorkflowStep[]
  executionLogs ExecutionLog[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, platformSourceId])
}

model Skill {
  id               String   @id @default(cuid())
  tenantId         String?
  platformSourceId String?
  name             String
  description      String   @db.Text
  promptContent    String   @db.Text
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agents AgentSkill[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, platformSourceId])
}

model AgentSkill {
  agentId String
  skillId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([agentId, skillId])
}

// ─── Workflows (React Flow graph) ───────────────────────────────────────────

model Workflow {
  id               String   @id @default(cuid())
  tenantId         String?
  platformSourceId String?
  name             String
  description      String?  @db.Text
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  steps  WorkflowStep[]
  edges  WorkflowEdge[]
  runs   ExecutionRun[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, platformSourceId])
}

model WorkflowStep {
  id           String  @id @default(cuid())
  workflowId   String
  agentId      String
  stepOrder    Int     @default(0)
  label        String?
  positionX    Float   @default(0)
  positionY    Float   @default(0)
  inputConfig  Json    @default("{}")
  outputConfig Json    @default("{}")

  workflow      Workflow       @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  agent         Agent          @relation(fields: [agentId], references: [id], onDelete: Restrict)
  edgesFrom     WorkflowEdge[] @relation("EdgeSource")
  edgesTo       WorkflowEdge[] @relation("EdgeTarget")
  executionLogs ExecutionLog[]

  @@index([workflowId, stepOrder])
}

model WorkflowEdge {
  id           String  @id @default(cuid())
  workflowId   String
  sourceStepId String
  targetStepId String
  sourceHandle String?
  targetHandle String?

  workflow   Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  sourceStep WorkflowStep @relation("EdgeSource", fields: [sourceStepId], references: [id], onDelete: Cascade)
  targetStep WorkflowStep @relation("EdgeTarget", fields: [targetStepId], references: [id], onDelete: Cascade)

  @@index([workflowId])
}

// ─── Execution history ──────────────────────────────────────────────────────

enum ExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model ExecutionRun {
  id           String          @id @default(cuid())
  workflowId   String
  tenantId     String?
  status       ExecutionStatus @default(PENDING)
  sharedMemory Json            @default("{}")
  totalTokens  Int             @default(0)
  totalCostUsd Float           @default(0)
  startedAt    DateTime?
  completedAt  DateTime?
  errorMessage String?         @db.Text
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  workflow Workflow       @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  tenant   Tenant?        @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  logs     ExecutionLog[]

  @@index([workflowId])
  @@index([status])
}

enum LogLevel {
  debug
  info
  warn
  error
}

model ExecutionLog {
  id         String   @id @default(cuid())
  runId      String
  stepId     String?
  agentId    String?
  level      LogLevel @default(info)
  message    String   @db.Text
  payload    Json?
  tokensUsed Int?
  costUsd    Float?
  createdAt  DateTime @default(now())

  run   ExecutionRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  step  WorkflowStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)
  agent Agent?        @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([runId, createdAt])
}

// ─── Consensus memory (tenant-level = company-wide; per-product is below) ────

model TenantConsensus {
  id           String       @id @default(cuid())
  tenantId     String       @unique
  content      String       @db.Text
  nextAction   String?      @db.Text
  companyPhase CompanyPhase @default(exploring)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

enum CompanyPhase {
  exploring
  validating
  building
  launching
  growing
}

enum ProductPhase {
  queued
  evaluating
  building
  launching
  growing
  paused
  archived
}

enum GoNoGoDecision {
  pending
  go
  no_go
}

enum ScheduleKind {
  workflow
  meta
}

model TenantCycleState {
  tenantId       String       @id
  cycleNumber    Int          @default(1)
  phase          CompanyPhase @default(exploring)
  stuckCounter   Int          @default(0)
  lastNextAction String?      @db.Text
  focusProductId String?
  updatedAt      DateTime     @updatedAt

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  focusProduct TenantProduct? @relation("FocusProduct", fields: [focusProductId], references: [id], onDelete: SetNull)
}

model TenantProduct {
  id           String         @id @default(cuid())
  tenantId     String
  slug         String
  name         String
  description  String?        @db.Text
  phase        ProductPhase   @default(queued)
  pipelineRank Int            @default(0)
  goNoGo       GoNoGoDecision @default(pending)
  revenueUsd   Float          @default(0)
  lastRunId    String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  focusCycles TenantCycleState[] @relation("FocusProduct")
  consensus   ProductConsensus?

  @@unique([tenantId, slug])
  @@index([tenantId, phase])
}

// ─── Per-product consensus (primary memory per product) ─────────────────────

model ProductConsensus {
  id          String   @id @default(cuid())
  productId   String   @unique
  tenantId    String
  content     String   @db.Text
  nextAction  String?  @db.Text
  cycleNumber Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product   TenantProduct              @relation(fields: [productId], references: [id], onDelete: Cascade)
  revisions ProductConsensusRevision[]

  @@index([tenantId])
}

model ProductConsensusRevision {
  id            String   @id @default(cuid())
  productId     String
  runId         String?
  stepId        String?
  agentName     String
  stepOrder     Int      @default(0)
  content       String   @db.Text
  nextAction    String?  @db.Text
  decisions     Json     @default("[]")
  openQuestions Json     @default("[]")
  veto          Json?
  createdAt     DateTime @default(now())

  product ProductConsensus @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@index([runId])
}

model PipelineIdea {
  id                  String         @id @default(cuid())
  tenantId            String
  title               String
  description         String?        @db.Text
  rank                Int            @default(0)
  interestScore       Float          @default(0)
  goNoGo              GoNoGoDecision @default(pending)
  promotedProductId   String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, rank])
  @@index([tenantId, interestScore])
}

model TenantInterest {
  id        String   @id @default(cuid())
  tenantId  String
  category  String
  weight    Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, category])
  @@index([tenantId])
}

// ─── Tenant LLM overrides ───────────────────────────────────────────────────

model TenantLlmConfig {
  tenantId         String         @id
  provider         AgentProvider?
  apiKey           String?
  baseUrl          String?
  defaultModel     String?
  maxCostUsdPerRun Float?
  updatedAt        DateTime       @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ─── Autonomous scheduler (replaces auto-loop.sh per tenant) ──────────────────

model AutonomousSchedule {
  id           String       @id @default(cuid())
  tenantId     String
  scheduleKind ScheduleKind @default(workflow)
  workflowId   String?
  name         String
  intervalSec  Int          @default(1800)
  enabled      Boolean      @default(true)
  lastRunAt    DateTime?
  nextRunAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([enabled, nextRunAt])
  @@index([tenantId])
}

// ─── Audit trail ────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorKind  String
  actorId    String
  actorEmail String?
  action     String
  tenantId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([actorKind, actorId])
}

// ─── Notifications ───────────────────────────────────────────────────────────

model TenantNotificationConfig {
  tenantId         String   @id
  webhookUrl       String?
  slackWebhookUrl  String?
  emailRecipients  String?  @db.Text
  notifyOnComplete Boolean  @default(true)
  notifyOnFail     Boolean  @default(true)
  updatedAt        DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ─── Usage limits (monthly caps) ─────────────────────────────────────────────

model TenantUsageLimits {
  tenantId           String   @id
  maxRunsPerMonth    Int?
  maxCostUsdPerMonth Float?
  maxTokensPerMonth  Int?
  updatedAt          DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ─── Password reset ──────────────────────────────────────────────────────────

model PasswordResetToken {
  id           String    @id @default(cuid())
  tenantUserId String
  tokenHash    String    @unique
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  tenantUser TenantUser @relation(fields: [tenantUserId], references: [id], onDelete: Cascade)

  @@index([tenantUserId])
}

// ─── Platform settings (superadmin UI; secrets encrypted) ───────────────────

model PlatformSettings {
  id                  String        @id @default("platform")
  publicUrl           String        @default("http://localhost:5173")
  defaultProvider     AgentProvider @default(tokenlab)
  defaultModel        String        @default("claude-3-5-sonnet-20241022")
  defaultTemperature  Float         @default(0.7)
  tokenlabApiKey      String?       @db.Text
  tokenlabBaseUrl     String        @default("https://api.lemondata.io/v1")
  openrouterApiKey    String?       @db.Text
  openrouterBaseUrl   String        @default("https://openrouter.ai/api/v1")
  openrouterReferer   String        @default("https://auto-company.local")
  customApiKey        String?       @db.Text
  customBaseUrl       String        @default("")
  resendApiKey        String?       @db.Text
  githubApiKey        String?       @db.Text
  emailFrom           String        @default("onboarding@resend.dev")
  executeRateLimitMax Int           @default(10)
  authRateLimitMax    Int           @default(30)
  shellTimeoutMs      Int           @default(30000)
  schedulerTickMs     Int           @default(60000)
  updatedAt           DateTime      @updatedAt
}
