{
  "name": "auto-company-platform",
  "version": "2.0.0",
  "private": true,
  "description": "Multi-tenant AI agent orchestration platform",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:frontend\"",
    "build": "tsc && npm run build --workspace=frontend",
    "start": "node dist/server/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "tsx --test tests/auth.test.ts tests/engine.test.ts",
    "worker": "tsx src/worker/index.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.3.22",
    "@fastify/cors": "^11.0.1",
    "@prisma/client": "^6.9.0",
    "ai": "^4.3.16",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.3",
    "zod": "^3.25.51",
    "@fastify/cookie": "^11.0.2",
    "@fastify/jwt": "^9.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.53.2",
    "ioredis": "^5.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@types/bcryptjs": "^2.4.6",
    "concurrently": "^9.1.2",
    "prisma": "^6.9.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
