# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/auto_company?schema=public"

# Server
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN="http://localhost:5173"

# Workspace root for agent file tools (defaults to repo root)
WORKSPACE_ROOT="/path/to/Auto-Company"

# Shell command timeout (ms)
SHELL_TIMEOUT_MS=30000

# Default LLM provider: tokenlab | openrouter | custom
DEFAULT_PROVIDER=tokenlab
DEFAULT_MODEL=claude-3-5-sonnet-20241022
DEFAULT_TEMPERATURE=0.7

# TokenLab / LemonData (OpenAI-compatible)
TOKENLAB_API_KEY=
TOKENLAB_BASE_URL=https://api.lemondata.io/v1

# OpenRouter (OpenAI-compatible)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Custom provider (OpenAI-compatible)
CUSTOM_API_KEY=
CUSTOM_BASE_URL=

# Auth (superadmin JWT in httpOnly cookie)
JWT_SECRET=change-me-in-production-use-long-random-string
SESSION_COOKIE_NAME=ac_session
SESSION_MAX_AGE_SEC=604800
AUTH_RATE_LIMIT_MAX=30

# Redis (BullMQ job queue — optional in dev; falls back to inline executor)
REDIS_URL=redis://localhost:6379
USE_INLINE_EXECUTOR=false

# Secret encryption for tenant LLM API keys (defaults to JWT_SECRET)
ENCRYPTION_KEY=

# Rate limits
EXECUTE_RATE_LIMIT_MAX=10

# Email (password reset + run notifications via Resend)
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
PUBLIC_URL=http://localhost:5173
