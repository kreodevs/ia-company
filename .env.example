# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/auto_company?schema=public"

# Server (infrastructure)
PORT=3001
HOST=0.0.0.0
# Optional override; otherwise CORS uses publicUrl from Admin → Platform settings
CORS_ORIGIN="http://localhost:5173"

# Workspace root for agent file tools (Docker: /app)
WORKSPACE_ROOT="/path/to/Auto-Company"

# Auth & encryption (secrets — do not store in app UI)
JWT_SECRET=change-me-in-production-use-long-random-string
ENCRYPTION_KEY=
SESSION_COOKIE_NAME=ac_session
SESSION_MAX_AGE_SEC=604800

# Redis (BullMQ job queue)
REDIS_URL=redis://localhost:6379
USE_INLINE_EXECUTOR=false

# App behavior (infrastructure)
NODE_ENV=development

# Legacy import only: values below are migrated into Platform settings on first boot.
# Configure defaults in the UI: /admin/settings (superadmin)
# PUBLIC_URL=http://localhost:5173
# DEFAULT_PROVIDER=tokenlab
# TOKENLAB_API_KEY=
# RESEND_API_KEY=
