# Production environment for Dokploy / Docker Compose
# Copy to Dokploy → Environment or use: docker compose --env-file .env.production up -d

# PostgreSQL (infra)
POSTGRES_USER=auto_company
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=auto_company

# Auth & encryption (secrets)
JWT_SECRET=change-me-use-openssl-rand-base64-48
ENCRYPTION_KEY=

# Redis (BullMQ)
REDIS_URL=redis://redis:6379

# Exposed port for the web (nginx) service
WEB_PORT=80

# Docker entrypoint flags
RUN_MIGRATIONS=true
RUN_SEED=true

# Optional infra overrides (app config lives in Admin → Platform settings)
# CORS_ORIGIN=https://auto-company.example.com
# WORKSPACE_ROOT is set to /app in docker-compose for api/worker

# Legacy one-time import into Platform settings (optional on first deploy)
# PUBLIC_URL=https://auto-company.example.com
# TOKENLAB_API_KEY=
# OPENROUTER_API_KEY=
# RESEND_API_KEY=
# EMAIL_FROM=Auto Company <noreply@yourdomain.com>
