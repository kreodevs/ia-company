# Production environment for Dokploy / Docker Compose
# Copy to Dokploy → Environment or use: docker compose --env-file .env.production up -d

# Public URL (used for CORS + cookies). Must match your Dokploy domain.
PUBLIC_URL=https://auto-company.example.com

# Exposed port for the web (nginx) service
WEB_PORT=80

# PostgreSQL
POSTGRES_USER=auto_company
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=auto_company

# Auth
JWT_SECRET=change-me-use-openssl-rand-base64-48
AUTH_RATE_LIMIT_MAX=30

# Redis (BullMQ job queue + autonomous scheduler)
REDIS_URL=redis://redis:6379

# Secret encryption for tenant LLM API keys
ENCRYPTION_KEY=

EXECUTE_RATE_LIMIT_MAX=10

# Email (password reset + run notifications via Resend)
RESEND_API_KEY=
EMAIL_FROM=Auto Company <noreply@yourdomain.com>

# First deploy: run migrations + platform template seed (no tenant, no superadmin)
RUN_MIGRATIONS=true
RUN_SEED=true

# LLM providers (optional until first workflow execution)
DEFAULT_PROVIDER=tokenlab
DEFAULT_MODEL=claude-3-5-sonnet-20241022
TOKENLAB_API_KEY=
TOKENLAB_BASE_URL=https://api.lemondata.io/v1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
